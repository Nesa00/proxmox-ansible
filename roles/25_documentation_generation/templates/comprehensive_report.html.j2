<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Comprehensive Proxmox System Report - {{ inventory_hostname }}</title>
    <style>
        /* Dracula Theme Colors */
        :root {
            --bg-color: #282a36;
            --current-line: #44475a;
            --foreground: #f8f8f2;
            --comment: #6272a4;
            --cyan: #8be9fd;
            --green: #50fa7b;
            --orange: #ffb86c;
            --pink: #ff79c6;
            --purple: #bd93f9;
            --red: #ff5555;
            --yellow: #f1fa8c;
        }

        body {
            font-family: 'Monaco', 'Menlo', 'Ubuntu Mono', monospace;
            background-color: var(--bg-color);
            color: var(--foreground);
            line-height: 1.6;
            margin: 0;
            padding: 20px;
        }

        .container {
            max-width: 1200px;
            margin: 0 auto;
            background-color: var(--bg-color);
            border-radius: 8px;
            padding: 20px;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.3);
        }

        h1 {
            color: var(--purple);
            text-align: center;
            border-bottom: 2px solid var(--current-line);
            padding-bottom: 10px;
            margin-bottom: 30px;
        }

        h2 {
            color: var(--pink);
            border-left: 4px solid var(--pink);
            padding-left: 15px;
            margin-top: 30px;
        }

        h3 {
            color: var(--cyan);
            margin-top: 25px;
        }

        .info-section {
            background-color: var(--current-line);
            padding: 15px;
            border-radius: 5px;
            margin: 15px 0;
            border-left: 4px solid var(--purple);
        }

        .highlight {
            color: var(--yellow);
            font-weight: bold;
        }

        .success {
            color: var(--green);
        }

        .warning {
            color: var(--orange);
        }

        .error {
            color: var(--red);
        }

        .code-block {
            background-color: #1e1f29;
            border: 1px solid var(--current-line);
            border-radius: 4px;
            padding: 15px;
            margin: 10px 0;
            overflow-x: auto;
            font-family: 'Monaco', 'Menlo', 'Ubuntu Mono', monospace;
        }

        .code-block pre {
            margin: 0;
            color: var(--foreground);
        }

        table {
            width: 100%;
            border-collapse: collapse;
            margin: 15px 0;
            background-color: var(--current-line);
            border-radius: 5px;
            overflow: hidden;
        }

        th {
            background-color: var(--purple);
            color: var(--bg-color);
            padding: 12px;
            text-align: left;
            font-weight: bold;
        }

        td {
            padding: 10px 12px;
            border-bottom: 1px solid var(--bg-color);
        }

        tr:nth-child(even) {
            background-color: rgba(68, 71, 90, 0.5);
        }

        .nav-menu {
            background-color: var(--current-line);
            padding: 15px;
            border-radius: 5px;
            margin-bottom: 20px;
        }

        .nav-menu ul {
            list-style: none;
            padding: 0;
            margin: 0;
            display: flex;
            flex-wrap: wrap;
        }

        .nav-menu li {
            margin-right: 20px;
            margin-bottom: 5px;
        }

        .nav-menu a {
            color: var(--cyan);
            text-decoration: none;
            padding: 5px 10px;
            border-radius: 3px;
            transition: background-color 0.3s;
        }

        .nav-menu a:hover {
            background-color: var(--bg-color);
            color: var(--purple);
        }

        .status-ok {
            color: var(--green);
            font-weight: bold;
        }

        .status-warning {
            color: var(--orange);
            font-weight: bold;
        }

        .status-error {
            color: var(--red);
            font-weight: bold;
        }

        .metric-value {
            color: var(--yellow);
            font-weight: bold;
        }

        .section-header {
            color: var(--purple);
            font-size: 1.2em;
            font-weight: bold;
            margin-top: 20px;
            margin-bottom: 10px;
        }

        .subsection-header {
            color: var(--cyan);
            font-size: 1.1em;
            font-weight: bold;
            margin-top: 15px;
            margin-bottom: 8px;
        }
    </style>
</head>
<body>
    <div class="container">
        <h1>Comprehensive Proxmox System Report - {{ inventory_hostname }}</h1>
        
        <div class="info-section">
            <p><span class="highlight">Generated:</span> {{ ansible_date_time.iso8601 }}</p>
            <p><span class="highlight">Hostname:</span> {{ inventory_hostname }}</p>
            <p><span class="highlight">IP Address:</span> {{ ansible_default_ipv4.address | default('Unknown') }}</p>
        </div>

        <div class="nav-menu">
            <h3>Table of Contents</h3>
            <ul>
                <li><a href="#system-overview">System Overview</a></li>
                <li><a href="#hardware-info">Hardware Information</a></li>
                <li><a href="#operating-system">Operating System</a></li>
                <li><a href="#proxmox-info">Proxmox Information</a></li>
                <li><a href="#storage-info">Storage Information</a></li>
                <li><a href="#network-info">Network Information</a></li>
                <li><a href="#virtualization">Virtualization</a></li>
                <li><a href="#security">Security Status</a></li>
                <li><a href="#performance">Performance Metrics</a></li>
            </ul>
        </div>

        <section id="system-overview">
            <h2>System Overview</h2>
            <div class="info-section">
                <h3>Basic System Information</h3>
                <table>
                    <tr>
                        <td><span class="highlight">Hostname:</span></td>
                        <td class="metric-value">{{ inventory_hostname }}</td>
                    </tr>
                    <tr>
                        <td><span class="highlight">IP Address:</span></td>
                        <td class="metric-value">{{ ansible_default_ipv4.address | default('Unknown') }}</td>
                    </tr>
                    <tr>
                        <td><span class="highlight">Generated:</span></td>
                        <td class="metric-value">{{ ansible_date_time.iso8601 }}</td>
                    </tr>
                </table>
            </div>
        </section>

        <section id="hardware-info">
            <h2>Hardware Information</h2>
            <div class="info-section">
                <h3>CPU Information</h3>
                <div class="code-block">
                    <pre>{{ cpu_info.stdout | default('CPU information not available') | strip_ansi }}</pre>
                </div>

                <h3>Memory Information</h3>
                <div class="code-block">
                    <pre>{{ memory_info.stdout | default('Memory information not available') | strip_ansi }}</pre>
                </div>

                <h3>Disk Information</h3>
                <div class="code-block">
                    <pre>{{ disk_info.stdout | default('Disk information not available') | strip_ansi }}</pre>
                </div>
            </div>
        </section>

        <section id="operating-system">
            <h2>Operating System</h2>
            <div class="info-section">
                <table>
                    <tr>
                        <td><span class="highlight">OS:</span></td>
                        <td class="metric-value">{{ ansible_distribution }} {{ ansible_distribution_version }}</td>
                    </tr>
                    <tr>
                        <td><span class="highlight">Kernel:</span></td>
                        <td class="metric-value">{{ ansible_kernel }}</td>
                    </tr>
                    <tr>
                        <td><span class="highlight">Architecture:</span></td>
                        <td class="metric-value">{{ ansible_architecture }}</td>
                    </tr>
                    <tr>
                        <td><span class="highlight">Boot Mode:</span></td>
                        <td class="metric-value">{{ global_boot_mode | default('Unknown') }}</td>
                    </tr>
                </table>
            </div>
        </section>

        <section id="proxmox-info">
            <h2>Proxmox Information</h2>
            <div class="info-section">
                <h3>Proxmox Version</h3>
                <div class="code-block">
                    <pre>{{ proxmox_version.stdout | default('Proxmox version not available') | strip_ansi }}</pre>
                </div>

                <h3>Cluster Status</h3>
                <div class="code-block">
                    <pre>{{ cluster_status.stdout | default('Cluster information not available') | strip_ansi }}</pre>
                </div>

                <h3>Storage Status</h3>
                <div class="code-block">
                    <pre>{{ storage_status.stdout | default('Storage status not available') | strip_ansi }}</pre>
                </div>

                <h3>ZFS Status</h3>
                <div class="code-block">
                    <pre>{{ zfs_status.stdout | default('ZFS information not available') | strip_ansi }}</pre>
                </div>
            </div>
        </section>

        <section id="storage-info">
            <h2>Storage Information</h2>
            <div class="info-section">
                <h3>Storage Configuration Export</h3>
                <div class="code-block">
                    <pre>{{ storage_export.stdout | default('Storage configuration not available') | strip_ansi }}</pre>
                </div>
            </div>
        </section>

        <section id="network-info">
            <h2>Network Information</h2>
            <div class="info-section">
                <h3>Network Interfaces</h3>
                <div class="code-block">
                    <pre>{{ network_info.stdout | default('Network information not available') | strip_ansi }}</pre>
                </div>

                <h3>Network Configuration Export</h3>
                <div class="code-block">
                    <pre>{{ network_config_export.stdout | default('Network configuration not available') | strip_ansi }}</pre>
                </div>

                <h3>DNS Configuration</h3>
                <div class="code-block">
                    <pre>{{ dns_info.stdout | default('DNS information not available') | strip_ansi }}</pre>
                </div>
            </div>
        </section>

        <section id="virtualization">
            <h2>Virtualization</h2>
            <div class="info-section">
                <h3>Virtual Machines</h3>
                <div class="code-block">
                    <pre>{{ vm_list.stdout | default('VM information not available') | strip_ansi }}</pre>
                </div>

                <h3>Containers</h3>
                <div class="code-block">
                    <pre>{{ container_list.stdout | default('Container information not available') | strip_ansi }}</pre>
                </div>
            </div>
        </section>

        <section id="security">
            <h2>Security Status</h2>
            <div class="info-section">
                <h3>Firewall and Security Information</h3>
                <div class="code-block">
                    <pre>{{ firewall_info.stdout | default('Firewall information not available') | strip_ansi }}</pre>
                </div>

                <h3>User Configuration</h3>
                <div class="code-block">
                    <pre>{{ user_export.stdout | default('User configuration not available') | strip_ansi }}</pre>
                </div>
            </div>
        </section>

        <section id="performance">
            <h2>Performance Metrics</h2>
            <div class="info-section">
                <h3>System Processes and Services</h3>
                <div class="code-block">
                    <pre>{{ processes_info.stdout | default('Process information not available') | strip_ansi }}</pre>
                </div>

                <h3>Performance Metrics</h3>
                <div class="code-block">
                    <pre>{{ performance_info.stdout | default('Performance information not available') | strip_ansi }}</pre>
                </div>

                <h3>System Logs</h3>
                <div class="code-block">
                    <pre>{{ logs_info.stdout | default('Log information not available') | strip_ansi }}</pre>
                </div>
            </div>
        </section>

        <footer style="margin-top: 40px; text-align: center; color: var(--comment); border-top: 1px solid var(--current-line); padding-top: 20px;">
            <p>Generated by Proxmox Documentation Generator with Dracula Theme</p>
            <p>Report generated on {{ ansible_date_time.iso8601 }} for {{ inventory_hostname }}</p>
        </footer>
    </div>
</body>
</html>
